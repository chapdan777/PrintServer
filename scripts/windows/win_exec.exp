#!/usr/bin/expect -f
set timeout 30
set host [lindex $argv 0]
set user [lindex $argv 1]
set password [expr {[info exists env(WIN_SSH_PASSWORD)] ? $env(WIN_SSH_PASSWORD) : "ssh"}]
set cmd [lrange $argv 2 end]

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$host $cmd
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
    }
    timeout {
        puts "Timeout connecting to $host"
        exit 1
    }
}
expect eof
